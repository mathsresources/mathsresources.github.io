simulate_ratio_dice <- function(N = 100000) {
results <- replicate(N, {
rolls <- sample(1:6, size = 10, replace = TRUE)
c(
four_fours = sum(rolls == 4) == 4,
five_fives = sum(rolls == 5) == 5
)
})
mean(results["four_fours", ]) /
mean(results["five_fives", ])
}
set.seed(123)
simulate_ratio_dice()
