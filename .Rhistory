fours_from_ten <- function(){}
results_from_ten <- function(target=4){
sample(1:6,10,replace=TRUE)
}
replicate(10000,results_from_ten)
table(replicate(10000,results_from_ten))
results_from_ten <- function(target=4){
sample(1:6,10,replace=TRUE)
}
results_from_ten()
count(results_from_ten()==4)
simulate_ratio_dice <- function(N = 100000) {
results <- replicate(N, {
rolls <- sample(1:6, size = 10, replace = TRUE)
c(
four_fours = sum(rolls == 4) == 4,
five_fives = sum(rolls == 5) == 5
)
})
mean(results["four_fours", ]) /
mean(results["five_fives", ])
}
set.seed(123)
simulate_ratio_dice()
